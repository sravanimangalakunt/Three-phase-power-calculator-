# Three Phase Power Calculator

import math

print("Three Phase Power Calculator")

voltage = float(input("Enter line voltage (V): "))
current = float(input("Enter line current (A): "))
power_factor = float(input("Enter power factor: "))

if voltage > 0 and current > 0 and 0 < power_factor <= 1:
    power = math.sqrt(3) * voltage * current * power_factor

    print("Three Phase Power =", round(power, 2), "W")
    print("Three Phase Power =", round(power / 1000, 2), "kW")
else:
    print("Please enter valid values.")